// ═══════ BUILDER ═══════
function seed_shuffle<T>(a:T[],s:number):T[]{
  const r=[...a];let x=s;
  for(let i=r.length-1;i>0;i--){x=(x*1103515245+12345)&0x7fffffff;const j=x%(i+1);[r[i],r[j]]=[r[j],r[i]];}
  return r;
}
function build(id:number,round:number,diff:"easy"|"medium"|"hard",raw:R,seed:number):Question{
  const[question,correct,w1,w2,w3]=raw;
  const opts=[correct,w1,w2,w3];
  const sh=seed_shuffle(opts,seed);
  const ai=sh.indexOf(correct);
  return{id,round,type:"multiple_choice",difficulty:diff,question,
    options:sh as[string,string,string,string],
    answer:(["A","B","C","D"] as const)[ai],timeLimit:30};
}

function gen():Question[]{
  const out:Question[]=[];let id=301;
  // Track which questions each round has used to avoid within-round duplicates
  for(let r=11;r<=100;r++){
    const usedE=new Set<number>(), usedM=new Set<number>(), usedD=new Set<number>();
    for(let i=0;i<10;i++){
      let idx=(r*7+i*31+r*r*3)%E.length;
      while(usedE.has(idx)) idx=(idx+1)%E.length;
      usedE.add(idx);
      out.push(build(id++,r,"easy",E[idx],r*100+i*37));
    }
    for(let i=0;i<10;i++){
      let idx=(r*11+i*37+r*r*5)%M.length;
      while(usedM.has(idx)) idx=(idx+1)%M.length;
      usedM.add(idx);
      out.push(build(id++,r,"medium",M[idx],r*200+i*41));
    }
    for(let i=0;i<10;i++){
      let idx=(r*13+i*43+r*r*7)%D.length;
      while(usedD.has(idx)) idx=(idx+1)%D.length;
      usedD.add(idx);
      out.push(build(id++,r,"hard",D[idx],r*300+i*53));
    }
  }
  return out;
}

const allQuestions=[...H,...gen()];
export default allQuestions;

export function getQuestionsForRound(round:number):Question[]{
  return allQuestions.filter(q=>q.round===round)
    .sort((a,b)=>{const o={easy:0,medium:1,hard:2};return o[a.difficulty]-o[b.difficulty];});
}
export function getTotalRounds():number{return 100;}
