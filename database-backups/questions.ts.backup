// ═══════════════════════════════════════════════════════════════════════════
// ANIME WIZ — 3000 UNIQUE QUESTIONS (100 rounds × 30 per round)
// Each round: 10 Easy → 10 Medium → 10 Hard, all multiple choice A/B/C/D
// Rounds 1-10: handcrafted. Rounds 11-100: drawn from 900-entry banks.
// ═══════════════════════════════════════════════════════════════════════════

export interface Question {
  id: number; round: number; type: "multiple_choice";
  difficulty: "easy"|"medium"|"hard"; question: string;
  options: [string,string,string,string]; answer: "A"|"B"|"C"|"D"; timeLimit: number;
}
function q(id:number,r:number,d:"easy"|"medium"|"hard",question:string,
  opts:[string,string,string,string],ans:"A"|"B"|"C"|"D"):Question{
  return{id,round:r,type:"multiple_choice",difficulty:d,question,options:opts,answer:ans,timeLimit:30};}

